{
  "name": "carpool-miniprogram",
  "version": "1.0.0",
  "private": true,
  "description": "社区拼车与顺风车出行管理小程序",
  "templateInfo": {
    "name": "default",
    "typescript": false,
    "css": "sass"
  },
  "scripts": {
    "build:weapp": "taro build --type weapp",
    "dev:weapp": "npm run build:weapp -- --watch",
    "build:h5": "taro build --type h5",
    "dev:h5": "npm run build:h5 -- --watch"
  },
  "browserslist": [
    "last 3 versions",
    "Android >= 4.1",
    "ios >= 8"
  ],
  "author": "",
  "dependencies": {
    "@tarojs/components": "3.6.30",
    "@tarojs/helper": "3.6.30",
    "@tarojs/plugin-framework-react": "3.6.30",
    "@tarojs/plugin-platform-weapp": "3.6.30",
    "@tarojs/plugin-platform-h5": "3.6.30",
    "@tarojs/react": "3.6.30",
    "@tarojs/runtime": "3.6.30",
    "@tarojs/shared": "3.6.30",
    "@tarojs/taro": "3.6.30",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "dayjs": "^1.11.10",
    "taro-ui": "^3.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@tarojs/cli": "3.6.30",
    "@tarojs/webpack5-runner": "3.6.30",
    "@types/react": "^18.2.0",
    "sass": "^1.69.0",
    "typescript": "^5.2.0"
  }
}
